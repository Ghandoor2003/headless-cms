
```gitignore
# Node.js
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Environment files
.env
.env.local
.env.*.local

# Build output
/build
/dist
/.next
/out
/public/static

# IDEs and editors
.vscode/
.idea/

# OS-specific files
.DS_Store
Thumbs.db

# Log files
*.log

# Temporary files
*.swp
*.swo

# Test directories (if using Jest, Mocha, etc.)
/coverage

# Dependency directories
# These directories are generated by package managers and contain the actual code dependencies
node_modules/
jspm_packages/

# Local configuration files
*.env
.vscode/

# Logs and runtime files
pids/
*.pid
*.seed
*.pid.lock

# Next.js
/.next
/out