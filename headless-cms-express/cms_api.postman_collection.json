{
  "info": {
    "name": "Dynamic CMS API",
    "_postman_id": "d8f0b3a2-0000-4000-9999-abcdef123456",
    "description": "Postman collection for testing the Dynamic CMS API (auth, categories, dynamic instances).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@example.com\",\n  \"password\": \"password123\",\n  \"category\": \"Staff\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TestCategory\",\n  \"dataFields\": [{\"name\":\"title\",\"type\":\"text\",\"required\":true}],\n  \"unique\": false,\n  \"deletable\": true,\n  \"changable\": true,\n  \"metaData\": {\"description\": \"Sample category\"}\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        }
      ]
    },
    {
      "name": "Instances",
      "item": [
        {
          "name": "Get All Instances",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/instances/User", "host": ["{{baseUrl}}"], "path": ["instances", "User"] }
          }
        },
        {
          "name": "Create Instance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"email\": \"newuser@example.com\",\n    \"password\": \"password123\",\n    \"role\": \"user\"\n  },\n  \"metaData\": {\"createdBy\":\"adminId\"}\n}"
            },
            "url": { "raw": "{{baseUrl}}/instances/User", "host": ["{{baseUrl}}"], "path": ["instances", "User"] }
          }
        },
        {
          "name": "Get Single Instance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/instances/User/{{instanceId}}", "host": ["{{baseUrl}}"], "path": ["instances", "User", "{{instanceId}}"] }
          }
        },
        {
          "name": "Update Instance",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\"role\": \"premium_user\"}\n}"
            },
            "url": { "raw": "{{baseUrl}}/instances/User/{{instanceId}}", "host": ["{{baseUrl}}"], "path": ["instances", "User", "{{instanceId}}"] }
          }
        },
        {
          "name": "Delete Instance",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/instances/User/{{instanceId}}", "host": ["{{baseUrl}}"], "path": ["instances", "User", "{{instanceId}}"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "instanceId", "value": "" }
  ]
}
